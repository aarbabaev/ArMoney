LOCAL_DB_PASSWORD=local-development-only-change-me
INTERNAL_AUTH_KEY=local-development-only-change-this-key

# Optional compose.sso.yaml; replace placeholders with independent random secrets.
ARMONEY_HOST=localhost
ARMONEY_BIND_ADDRESS=127.0.0.1
SSO_CLIENT_SECRET=replace-with-random-32-or-more-characters
SSO_DB_PASSWORD=replace-with-random-database-password
SSO_ADMIN_USERNAME=admin
SSO_ADMIN_PASSWORD=replace-with-random-admin-password

# Optional compose.ledger-replication.yaml: independent replication-only secret.
LEDGER_REPLICATION_PASSWORD=replace-with-independent-random-replication-password

# Transactional email: disabled until Mailtrap credentials are configured.
# Sandbox captures messages; sending delivers to real, verified recipient emails.
EMAIL_DELIVERY_ENABLED=false
MAILTRAP_MODE=sandbox
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=
MAILTRAP_FROM_NAME=ArMoney
