# DISPOSABLE ACCEPTANCE IMAGE ONLY. Build context is the repository root.
FROM gradle:8.14.3-jdk21@sha256:21bd311ed01360c189b8870c6b6e988199ff10f72d445d02fb39d3cff9da91d7 AS acceptance-build
USER root
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
WORKDIR /workspace
COPY gradlew ./gradlew
COPY gradle/wrapper/ ./gradle/wrapper/
COPY sso-service/Dockerfile ./sso-service/Dockerfile
COPY sso-service/provider/build.gradle sso-service/provider/settings.gradle sso-service/provider/package-provider.sh ./sso-service/provider/
COPY sso-service/provider/src/ ./sso-service/provider/src/
COPY sso-service/themes/armoney/login/ ./sso-service/themes/armoney/login/
COPY sso-service/provider/acceptance-fixture/build.gradle sso-service/provider/acceptance-fixture/settings.gradle sso-service/provider/acceptance-fixture/Dockerfile.code-intent ./sso-service/provider/acceptance-fixture/
COPY sso-service/provider/acceptance-fixture/src/ ./sso-service/provider/acceptance-fixture/src/
RUN printf '%s\n' 'com.arman.bank.sso.CodeIntentFixtureLoginProtocolFactory' > sso-service/provider/acceptance-fixture/src/main/resources/META-INF/services/org.keycloak.protocol.LoginProtocolFactory \
    && printf '%s\n' 'com.arman.bank.sso.CodeIntentFixtureResourceFactory' > sso-service/provider/acceptance-fixture/src/main/resources/META-INF/services/org.keycloak.services.resource.RealmResourceProviderFactory \
    && printf '%s\n' 'com.arman.bank.sso.CodeIntentFixtureActionFactory' > sso-service/provider/acceptance-fixture/src/main/resources/META-INF/services/org.keycloak.authentication.RequiredActionFactory \
    && printf '%s\n' 'parent=armoney' > sso-service/provider/acceptance-fixture/src/main/resources/theme/armoney-code-intent-fixture/login/theme.properties \
    && printf '%s\n' '{"themes":[{"name":"armoney-code-intent-fixture","types":["login"]}]}' > sso-service/provider/acceptance-fixture/src/main/resources/META-INF/keycloak-themes.json \
    && bash sso-service/provider/package-provider.sh /provider-package \
    && bash gradlew -p sso-service/provider/acceptance-fixture check codeIntentJar --no-daemon --max-workers=1 \
    && mkdir -p /fixture-provenance \
    && sha256sum sso-service/provider/acceptance-fixture/build/libs/armoney-code-intent-acceptance-fixture-0.1.0.jar > /fixture-provenance/fixture-artifact.sha256 \
    && find sso-service/provider/acceptance-fixture/src sso-service/provider/acceptance-fixture/build.gradle sso-service/provider/acceptance-fixture/settings.gradle sso-service/provider/acceptance-fixture/Dockerfile.code-intent -type f -print0 | sort -z | xargs -0 sha256sum > /fixture-provenance/fixture-source.sha256

FROM quay.io/keycloak/keycloak:26.7.4@sha256:82a77884f3af238beab1e7afd63b5f530e1b5c0590bd7aa60b40a40463e29b2c AS fixture-augmentation
COPY --from=acceptance-build --chown=keycloak:keycloak /provider-package/providers/ /opt/keycloak/providers/
COPY --from=acceptance-build --chown=keycloak:keycloak /provider-package/themes/ /opt/keycloak/themes/
COPY --from=acceptance-build --chown=keycloak:keycloak /workspace/sso-service/provider/acceptance-fixture/build/libs/armoney-code-intent-acceptance-fixture-0.1.0.jar /opt/keycloak/providers/
RUN touch -m --date=@1743465600 /opt/keycloak/providers/*.jar && /opt/keycloak/bin/kc.sh build --db=postgres

FROM quay.io/keycloak/keycloak:26.7.4@sha256:82a77884f3af238beab1e7afd63b5f530e1b5c0590bd7aa60b40a40463e29b2c
COPY --from=fixture-augmentation --chown=keycloak:keycloak /opt/keycloak/ /opt/keycloak/
COPY --from=acceptance-build --chown=keycloak:keycloak /provider-package/provenance/ /opt/keycloak/conf/armoney-provider-package/
COPY --from=acceptance-build --chown=keycloak:keycloak /fixture-provenance/ /opt/keycloak/conf/armoney-code-intent-fixture/
LABEL org.opencontainers.image.title="ArMoney DISPOSABLE code-intent acceptance fixture - never deploy" \
      com.armoney.artifact.scope="disposable-code-intent-only"
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
# No default enable flag, credential, realm import or provider activation.
