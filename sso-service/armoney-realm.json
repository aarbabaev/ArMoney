{
  "realm": "armoney",
  "displayName": "ArMoney",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(15)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "armoney-ios",
      "name": "ArMoney iOS",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "com.armoney.ios:/oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.armoney.ios:/oauth/logout",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "armoney-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "armoney-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "armoney-auth-introspection-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "armoney-auth",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "protocol": "openid-connect",
          "name": "armoney-phone",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "id.token.claim": "false",
            "claim.name": "phone_number",
            "introspection.token.claim": "true",
            "user.attribute": "username",
            "access.token.claim": "true",
            "jsonType.label": "String",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "armoney-android",
      "name": "ArMoney Android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "com.armoney.android:/oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.armoney.android:/oauth/logout",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "armoney-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "armoney-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "armoney-auth-introspection-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "armoney-auth",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "protocol": "openid-connect",
          "name": "armoney-phone",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "id.token.claim": "false",
            "claim.name": "phone_number",
            "introspection.token.claim": "true",
            "user.attribute": "username",
            "access.token.claim": "true",
            "jsonType.label": "String",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "armoney-auth",
      "name": "ArMoney private token introspection",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SSO_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "editUsernameAllowed": false,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"UAE mobile number (+971)\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":13,\"max\":13},\"pattern\":{\"pattern\":\"^\\\\+9715[024568][0-9]{7}$\"},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"annotations\":{\"inputType\":\"html5-tel\",\"inputTypePlaceholder\":\"+971501234567\",\"inputHelperTextBefore\":\"Enter your UAE mobile number including +971. Phone ownership is not verified.\"}},{\"name\":\"email\",\"displayName\":\"${email}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        },
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile"
      }
    ]
  }
}
