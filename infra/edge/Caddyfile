{
    admin off
    # IP-address clients omit SNI; select the certificate for the configured origin.
    default_sni {$ARMONEY_HOST}
    auto_https disable_redirects
}
https://{$ARMONEY_HOST}:443 {
    tls internal
    # No access log: authorization codes and credentials must not be logged.
    @oidc path /sso/realms/armoney/.well-known/* /sso/realms/armoney/protocol/openid-connect/* /sso/realms/armoney/login-actions/* /sso/resources/*
    handle @oidc {
        reverse_proxy sso-service:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$ARMONEY_HOST}:8443
            header_up X-Forwarded-Port 8443
        }
    }
    @api path /v1/* /health/live /health/ready /openapi.yaml
    handle @api {
        reverse_proxy app-gateway:8080
    }
    handle {
        respond 404
    }
}
