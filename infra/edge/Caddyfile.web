{
    admin off
    # IP-address clients omit SNI; select the certificate for the configured origin.
    default_sni {$ARMONEY_HOST}
    auto_https disable_redirects
}
https://{$ARMONEY_HOST}:443 {
    tls internal
    # No access log: authorization codes and credentials must not be logged.
    @oidc path /sso/realms/armoney/.well-known/* /sso/realms/armoney/protocol/openid-connect/* /sso/realms/armoney/login-actions/* /sso/resources/*
    handle @oidc {
        reverse_proxy sso-service:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {$ARMONEY_HOST}:8443
            header_up X-Forwarded-Port 8443
        }
    }
    @blockedSso path /sso /sso/*
    handle @blockedSso {
        respond 404
    }
    @internal path /internal /internal/*
    handle @internal {
        respond 404
    }
    @api path /v1/* /health/live /health/ready /openapi.yaml
    handle @api {
        reverse_proxy app-gateway:8080
    }
    handle {
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
            Referrer-Policy "no-referrer"
            X-Content-Type-Options "nosniff"
            Permissions-Policy "camera=(), microphone=(), geolocation=()"
            Cache-Control "no-store"
        }
        reverse_proxy web:8080
    }
}
