    tls /fixture/certs/server.crt /fixture/certs/server.key
    reverse_proxy sso-a:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 8443
        transport http {
            versions 1.1
        }
    }
}
