# Common settings; prepare-config.sh supplies validated node identity and TLS paths.
controller.quorum.bootstrap.servers=kafka-controller-1:9093,kafka-controller-2:9093,kafka-controller-3:9093
controller.listener.names=CONTROLLER
listener.security.protocol.map=CONTROLLER:SSL,BROKER:SSL
inter.broker.listener.name=BROKER
log.dirs=/var/lib/kafka/data
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
allow.everyone.if.no.acl.found=false
super.users=User:admin;User:kafka-controller-1;User:kafka-controller-2;User:kafka-controller-3;User:kafka-broker-1;User:kafka-broker-2;User:kafka-broker-3
ssl.principal.mapping.rules=RULE:^CN=(.*)$/$1/,DEFAULT
ssl.client.auth=required
ssl.endpoint.identification.algorithm=https
ssl.enabled.protocols=TLSv1.3,TLSv1.2
ssl.keystore.type=PKCS12
ssl.keystore.location=/run/kafka-secrets/keystore.p12
ssl.truststore.type=PKCS12
ssl.truststore.location=/run/kafka-secrets/truststore.p12
auto.create.topics.enable=false
delete.topic.enable=false
default.replication.factor=3
min.insync.replicas=2
unclean.leader.election.enable=false
num.partitions=3
log.retention.hours=168
log.retention.check.interval.ms=300000
log.segment.bytes=67108864
message.max.bytes=32768
replica.fetch.max.bytes=1048576
offsets.topic.replication.factor=3
offsets.topic.num.partitions=3
transaction.state.log.replication.factor=3
transaction.state.log.min.isr=2
transaction.state.log.num.partitions=3
group.initial.rebalance.delay.ms=0
num.network.threads=3
num.io.threads=4

